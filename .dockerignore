# Ignore node_modules to reduce image size and because dependencies are installed inside the container
node_modules

# Ignore npm debug logs
npm-debug.log

# Ignore the .dockerignore file itself
.dockerignore

# Ignore Git repository files
.git
.gitignore

# Ignore environment variable files that may contain secrets
.env

# Ignore DALL·E-related files (image cache or metadata if generated by OpenAI API)
dalle/