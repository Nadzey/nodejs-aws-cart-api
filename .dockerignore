# Node dependencies - rebuilt inside the container
node_modules

# Output build folders - we build inside Docker
dist

# NPM/Yarn/PNPM lock files (optional, but useful if you use `COPY package*.json`)
npm-debug.log
yarn-error.log
pnpm-lock.yaml

# Docker config files (doesn't hurt to ignore themselves)
Dockerfile
.dockerignore

# Git-related files
.git
.gitignore

# Environment and secrets
.env
.env.local

# IDE/editor/project configs
.vscode/
.idea/
*.swp

# OS and temp files
.DS_Store
Thumbs.db

# Images or custom folders if generated locally
dalle/
