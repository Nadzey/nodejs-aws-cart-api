# === Stage 1: Build ===
FROM node:18-alpine AS builder

WORKDIR /app

# Only install dependencies first
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build the app (e.g. TypeScript → JavaScript)
RUN npm run build


# === Stage 2: Production Image ===
FROM node:18-alpine AS production

WORKDIR /app

# Copy only built files and necessary runtime files from builder
COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

# Optional: if you need any config/env files, copy them too
# COPY .env .env

# Start the service
CMD ["node", "dist/source/lambda.js"]